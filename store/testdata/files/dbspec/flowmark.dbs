dbspec 1 flowmark

table tasks {
  id varchar(32)
  parent varchar(32) null
  title varchar(255)
  body text
  position i32
  owner varchar(32) null
  estimate decimal(6,2) null
  done bool
  score f64 null
  seen_on date null
  seen_at datetime(0) null
  clock time(3) null
  ref uuid null
  blob bytes null
  weight i16 null
  big i64 null
  note text null
  evidence text null
  cause text null
  primary key (id)
  index ix_tasks_parent (parent)
  foreign key fk_tasks_parent (parent) references tasks (id) on delete restrict on update restrict
  settings {
    key_prefix 'T'
    store files
    title title
    body body
    order position
    markdown body
    markdown evidence
    markdown cause
  }
}

table memos {
  id varchar(16)
  title varchar(64)
  body text
  summary text null
  primary key (id)
  settings {
    store files
    title title
    body body
    markdown body
    markdown summary
  }
}
