{
  "name": "flowmark-board",
  "version": "0.0.0",
  "private": true,
  "description": "The board example of flowmark: hyper pages over a flowmark corpus that orm reaches through markdown://",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@polyspec/hyper-client": "https://github.com/polyspec/hyper/releases/download/v0.0.25/polyspec-hyper-client-0.0.25.tgz",
    "htmx.org": "4.0.0",
    "@polyspec/template": "https://github.com/polyspec/template/releases/download/v0.0.19/polyspec-template-0.0.19.tgz",
    "@polyspec/hyper-server": "https://github.com/polyspec/hyper/releases/download/v0.0.25/polyspec-hyper-server-0.0.25.tgz",
    "@polyspec/orm": "https://github.com/polyspec/orm/releases/download/v0.0.21/polyspec-orm-0.0.21.tgz",
    "@polyspec/ordered-json": "https://github.com/polyspec/ordered-json/releases/download/v0.0.18/polyspec-ordered-json-0.0.18.tgz",
    "@polyspec/crudui-generator-core": "https://github.com/polyspec/crudui/releases/download/v0.0.12/polyspec-crudui-generator-core-0.0.12.tgz",
    "@polyspec/crudui-generator-html": "https://github.com/polyspec/crudui/releases/download/v0.0.12/polyspec-crudui-generator-html-0.0.12.tgz",
    "@polyspec/crudui-validator": "https://github.com/polyspec/crudui/releases/download/v0.0.12/polyspec-crudui-validator-0.0.12.tgz"
  },
  "overrides": {
    "@polyspec/hyper-client": "https://github.com/polyspec/hyper/releases/download/v0.0.25/polyspec-hyper-client-0.0.25.tgz",
    "@polyspec/template": "https://github.com/polyspec/template/releases/download/v0.0.19/polyspec-template-0.0.19.tgz",
    "@polyspec/hyper-server": "https://github.com/polyspec/hyper/releases/download/v0.0.25/polyspec-hyper-server-0.0.25.tgz",
    "@polyspec/orm": "https://github.com/polyspec/orm/releases/download/v0.0.21/polyspec-orm-0.0.21.tgz",
    "@polyspec/ordered-json": "https://github.com/polyspec/ordered-json/releases/download/v0.0.18/polyspec-ordered-json-0.0.18.tgz",
    "@polyspec/crudui-generator-core": "https://github.com/polyspec/crudui/releases/download/v0.0.12/polyspec-crudui-generator-core-0.0.12.tgz",
    "@polyspec/crudui-generator-html": "https://github.com/polyspec/crudui/releases/download/v0.0.12/polyspec-crudui-generator-html-0.0.12.tgz",
    "@polyspec/crudui-validator": "https://github.com/polyspec/crudui/releases/download/v0.0.12/polyspec-crudui-validator-0.0.12.tgz"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "scripts": {
    "typecheck": "node node_modules/typescript/lib/tsc.js -p node/tsconfig.json",
    "build:node": "esbuild node/main.ts --bundle --platform=node --format=esm --target=node26 --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\" --outfile=build/node/server.mjs"
  }
}
