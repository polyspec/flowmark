{
    "name": "flowmark/board",
    "description": "The board example of flowmark: hyper pages over a flowmark corpus that orm reaches through markdown://",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "composer",
            "url": "https://github.com/polyspec/ordered-json/releases/download/v0.0.16/packages.json"
        },
        {
            "type": "composer",
            "url": "https://github.com/polyspec/template/releases/download/v0.0.19/packages.json"
        },
        {
            "type": "composer",
            "url": "https://github.com/polyspec/hyper/releases/download/v0.0.25/packages.json"
        },
        {
            "type": "composer",
            "url": "https://github.com/polyspec/orm/releases/download/v0.0.20/packages.json"
        },
        {
            "type": "composer",
            "url": "https://github.com/polyspec/crudui/releases/download/v0.0.12/packages.json"
        },
        {
            "type": "vcs",
            "url": "https://github.com/min-0-max/yaml",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/min-0-max/json-schema",
            "no-api": true
        }
    ],
    "require": {
        "php": ">=8.5",
        "polyspec/crudui-generator": "0.0.12",
        "polyspec/hyper-server": "0.0.25",
        "polyspec/orm": "0.0.20",
        "polyspec/template": "0.0.19"
    },
    "autoload": {
        "psr-4": {
            "Flowmark\\Board\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
