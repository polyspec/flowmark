dbspec 1 conformance

table tasks {
  id varchar(16)
  parent varchar(16) null
  title varchar(255)
  body text
  position i32
  done bool
  due date null
  label varchar(32) null
  primary key (id)
  index ix_tasks_parent (parent)
  foreign key fk_tasks_parent (parent) references tasks (id) on delete restrict on update restrict
  settings {
    store document list
    title title
    body body
    order position
    markdown body
  }
}
