#!/bin/sh
# commit-msg hook: refuses a commit whose message breaks config/commits.json, or whose checklist changes break the item
# rules (one item per commit, the changelog of a finished item), with the rule and the reason. It calls the make target of
# the check, which runs the tool of the installed @polyspec/kit.
cd "$(git rev-parse --show-toplevel)" || exit 1
exec make --no-print-directory commit-msg-check MESSAGE="$1"
