{
  "schema": 1,
  "include": [
    "**/*.md"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/vendor/**",
    "**/testdata/**",
    "**/*.flowmark.md"
  ],
  "changelogs": [
    "CHANGELOG.md"
  ],
  "changelogRules": [
    "unreleased-first",
    "unreleased-once",
    "versions-only",
    "newest-first",
    "unreleased-empty-at-release"
  ]
}
