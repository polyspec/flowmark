{
  "schema": 1,
  "comment": "The owner checks of the repository paths, read by owner-check of @polyspec/kit: make owner-check runs the targets of the rules whose globs match a changed path, and make owner-validate checks that every tracked path has a rule and every glob matches a tracked path.",
  "owners": [
    {
      "paths": [
        "*.md",
        "docs/**",
        "config/documents.json",
        "config/checklist.json"
      ],
      "targets": [
        "docs-check",
        "refs-check"
      ]
    },
    {
      "paths": [
        "docs/plans/*/checklist/**",
        "scripts/checklist.mts",
        "packages/go/ops/checklist_test.go"
      ],
      "targets": [
        "checklist-check"
      ]
    },
    {
      "paths": [
        "config/duplication.json"
      ],
      "targets": [
        "duplication-check"
      ]
    },
    {
      "paths": [
        "AGENTS.md",
        "PRINCIPLES.md",
        "PRINCIPLES.ko.md"
      ],
      "targets": [
        "rules-check"
      ]
    },
    {
      "paths": [
        "packages/go/**",
        "go.work"
      ],
      "targets": [
        "lint-go",
        "duplication-check",
        "lint-ts",
        "test-go"
      ]
    },
    {
      "paths": [
        "tests/**"
      ],
      "targets": [
        "lint-ts",
        "duplication-check",
        "test-infrastructure"
      ]
    },
    {
      "paths": [
        "tests/conformance/**"
      ],
      "targets": [
        "lint-go",
        "duplication-check"
      ]
    },
    {
      "paths": [
        "docs/spec/**"
      ],
      "targets": [
        "test-go"
      ]
    },
    {
      "paths": [
        "scripts/check-internal-paths.mts"
      ],
      "targets": [
        "internal-paths-check"
      ]
    },
    {
      "paths": [
        "scripts/**"
      ],
      "targets": [
        "lint-ts",
        "duplication-check",
        "test-infrastructure"
      ]
    },
    {
      "paths": [
        "Makefile"
      ],
      "targets": [
        "owner-validate"
      ]
    },
    {
      "paths": [
        "config/layout.kit.yml",
        "config/layout.yml",
        "config/*.schema.json",
        "config/generated.json",
        ".editorconfig",
        ".gitignore",
        ".gitattributes",
        ".github/**"
      ],
      "targets": [
        "layout-check"
      ]
    },
    {
      "paths": [
        "config/toolchain.json",
        "mise.toml",
        "mise.lock",
        ".mise/**"
      ],
      "targets": []
    },
    {
      "paths": [
        ".golangci.yml"
      ],
      "targets": [
        "lint-go"
      ]
    },
    {
      "paths": [
        "knip.json",
        ".oxlintrc.json",
        ".npmrc",
        "package.json",
        "package-lock.json",
        "tsconfig.json"
      ],
      "targets": [
        "lint-ts"
      ]
    },
    {
      "paths": [
        "sidecar.json"
      ],
      "targets": [
        "flowmark-build"
      ]
    },
    {
      "paths": [
        "config/owner-checks.json"
      ],
      "targets": [
        "owner-validate"
      ]
    },
    {
      "paths": [
        "config/rebuild.json"
      ],
      "targets": [
        "rebuild-check"
      ]
    },
    {
      "paths": [
        "config/release.json"
      ],
      "targets": []
    }
  ]
}
