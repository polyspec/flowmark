dbspec 1 flowmark

table items {
  id varchar(32)
  parent varchar(32) null
  state varchar(16)
  title varchar(255)
  body text
  assignee varchar(32) null
  start_on date null
  start_at datetime(0) null
  due_on date null
  due_at datetime(0) null
  priority i16 null
  position i32
  evidence text null
  cause text null
  retry text null
  primary key (id)
  index ix_items_parent (parent)
  index ix_items_assignee (assignee)
  foreign key fk_items_parent (parent) references items (id) on delete restrict on update restrict
  foreign key fk_items_assignee (assignee) references people (id) on delete restrict on update restrict
  check ck_items_start (start_on is null or start_at is null)
  check ck_items_due (due_on is null or due_at is null)
  settings {
    key_prefix 'T'
    store document list
    title title
    body body
    order position
    markdown body
    markdown evidence
    markdown cause
    markdown retry
    checkbox state waiting ' '
    checkbox state doing '~'
    checkbox state done 'o'
    checkbox state bypassed '!'
    checkbox state impossible '-'
    state_machine state initial waiting
    state_machine state waiting -> doing
    state_machine state doing -> done require (evidence)
    state_machine state doing -> bypassed require (cause, retry)
    state_machine state bypassed -> doing
    state_machine state waiting -> impossible require (cause)
    state_machine state terminal done
    state_machine state terminal impossible
    state_machine state history item_history row item from from_state to to_state at at
  }
}

table people {
  id varchar(32)
  name varchar(255)
  primary key (id)
  settings {
    key_prefix 'P'
    store document table
    title name
  }
}

table item_links {
  id i64 identity
  from_item varchar(32)
  to_item varchar(32)
  kind varchar(16)
  primary key (id)
  index ix_item_links_from (from_item)
  index ix_item_links_to (to_item)
  foreign key fk_item_links_from (from_item) references items (id) on delete restrict on update restrict
  foreign key fk_item_links_to (to_item) references items (id) on delete restrict on update restrict
  check ck_item_links_kind (kind in ('blocks', 'relates', 'duplicates', 'supersedes'))
  settings {
    store document table
  }
}

table item_history {
  id i64 identity
  item varchar(32)
  from_state varchar(16)
  to_state varchar(16)
  at datetime(6)
  evidence text null
  cause text null
  retry text null
  primary key (id)
  index ix_item_history_item (item)
  foreign key fk_history_item (item) references items (id) on delete restrict on update restrict
  settings {
    store block fk_history_item table
    markdown evidence
    markdown cause
    markdown retry
  }
}

table views {
  id i64 identity
  title varchar(255)
  body text
  kind varchar(16)
  entity varchar(63)
  filter text
  sort text
  group_by varchar(63) null
  primary key (id)
  check ck_views_kind (kind in ('kanban', 'list', 'gantt'))
  settings {
    store document table
    title title
    body body
    markdown body
    codec filter ordered_json
    codec sort ordered_json
  }
}
